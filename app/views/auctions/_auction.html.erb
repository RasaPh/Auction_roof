<article class="a-card">
  <%= link_to auction, class: "a-card__link" do %>
    <div class="a-card__cover">
      <%= auction_cover(auction) %>
      <%= phase_badge(auction) %>
    </div>
    <div class="a-card__body">
      <h3><%= auction.title %></h3>
      <%= render "auctions/card_price", auction: auction %>
      <% case auction.phase %>
      <% when :live %>
        <p class="a-card__time">ปิดใน <span data-controller="countdown" data-countdown-at-value="<%= auction.ends_at.iso8601 %>"></span></p>
      <% when :upcoming %>
        <p class="a-card__time">เริ่ม <%= thai_datetime(auction.starts_at) %></p>
      <% else %>
        <p class="a-card__time">ปิด <%= thai_datetime(auction.ends_at) %></p>
      <% end %>
    </div>
  <% end %>
</article>
