<% content_for :admin_title, "เพิ่มผู้ใช้งาน" %>

<header class="admin-head">
  <h1>เพิ่มผู้ใช้งาน</h1>
</header>

<section class="panel">
  <% if @user.errors.any? %>
    <div class="flash flash--alert">
      <ul><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_with model: [ :admin, @user ], class: "form" do |form| %>
    <div class="grid">
      <div class="field">
        <%= form.label :username, "ชื่อผู้ใช้ (username)" %>
        <%= form.text_field :username, required: true, autocomplete: "off" %>
      </div>
      <div class="field">
        <%= form.label :role_id, "บทบาท" %>
        <%= form.collection_select :role_id, @roles, :id, :name, include_blank: "— ไม่มีบทบาท —" %>
      </div>
      <div class="field">
        <%= form.label :first_name, "ชื่อ" %>
        <%= form.text_field :first_name, required: true %>
      </div>
      <div class="field">
        <%= form.label :last_name, "นามสกุล" %>
        <%= form.text_field :last_name, required: true %>
      </div>
      <div class="field">
        <%= form.label :phone, "เบอร์โทรศัพท์" %>
        <%= form.telephone_field :phone, required: true, inputmode: "numeric" %>
      </div>
      <div class="field">
        <%= form.label :email_address, "อีเมล" %>
        <%= form.email_field :email_address %>
      </div>
      <div class="field">
        <%= form.label :password, "รหัสผ่าน (อย่างน้อย 8 ตัว)" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password" %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "ยืนยันรหัสผ่าน" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
      </div>
    </div>
    <div class="form-actions">
      <%= link_to "ยกเลิก", admin_users_path, class: "btn btn-ghost" %>
      <%= form.submit "สร้างผู้ใช้งาน", class: "btn" %>
    </div>
  <% end %>
</section>
