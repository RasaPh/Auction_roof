<% content_for :title, "ตั้งรหัสผ่านใหม่ | Auction Roof" %>

<div class="card">
  <h1 class="card__title">Forgot password</h1>
  <p class="muted">เบอร์ <strong><%= session[:password_reset_phone] %></strong> · รหัส OTP มีอายุ 10 นาที</p>

  <%= form_with url: password_reset_path, method: :patch, class: "form" do |form| %>
    <div class="field">
      <label for="otp_0">OTP</label>
      <div class="otp" data-controller="otp">
        <% User::OTP_LENGTH.times do |i| %>
          <input type="text" name="otp[]" id="otp_<%= i %>" inputmode="numeric" pattern="[0-9]" maxlength="1"
                 required autocomplete="<%= i.zero? ? "one-time-code" : "off" %>" <%= "autofocus" if i.zero? %>
                 aria-label="OTP หลักที่ <%= i + 1 %>"
                 data-otp-target="digit" data-action="input->otp#next keydown->otp#back paste->otp#paste">
        <% end %>
      </div>
    </div>

    <div class="field">
      <%= form.label :password, "รหัสผ่านใหม่ (อย่างน้อย 8 ตัว)" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72 %>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "ยืนยันรหัสผ่านใหม่" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <%= form.submit "Confirm", class: "btn" %>
  <% end %>

  <p class="links"><%= link_to "ขอรหัส OTP ใหม่", new_password_reset_path %></p>
</div>
